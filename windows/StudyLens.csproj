<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>StudyLens</AssemblyName>
    <RootNamespace>StudyLens</RootNamespace>
    <ApplicationIcon>Assets\studylens.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <Product>StudyLens</Product>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\AgravePro-Regular.ttf" />
    <Resource Include="Assets\hero.jpg" />
    <Resource Include="Assets\app_icon.png" />
    <Resource Include="Assets\mark.png" />
    <Resource Include="Assets\studylens.ico" />
  </ItemGroup>
</Project>
